# RailMate Environment Variables

# App Environment
ENVIRONMENT=development
APP_NAME=RailMate
SECRET_KEY=railmate_super_secret_jwt_key_change_in_production_987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For MySQL 8 (Production or local MySQL server):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/railmate
# Default local SQLite fallback for out-of-the-box zero-setup demonstration:
DATABASE_URL=sqlite:///./railmate.db

# AI Provider Configuration
# Supported: gemini, openrouter, mock
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Railway Data Provider
# Supported: demo, live
RAILWAY_PROVIDER=demo
RAILWAY_API_BASE_URL=https://api.railway-example.gov.in/v1
RAILWAY_API_KEY=your_railway_api_key_here

# Frontend CORS Origin
FRONTEND_ORIGIN=http://localhost:5173

# Optional Email Notification Provider
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=notifications@railmate.internal
